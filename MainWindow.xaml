<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" MinWidth="120"/>
            <ColumnDefinition/>

        </Grid.ColumnDefinitions>
        <Label Content="QUAN LY BENH NHAN" Grid.ColumnSpan="2" FontSize="20"  FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="0"/>
        <Label Content="Ma benh nhan" HorizontalAlignment="Left" Grid.Row="1" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtMaBenhNhan" Grid.Column="1" HorizontalContentAlignment="Left" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" />
        
        <Label Content="Ho ten " HorizontalAlignment="Left" Grid.Row="2" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtHoTen" Grid.Column="1" HorizontalContentAlignment="Left" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" />
        
        <Label Content="Dia chi" HorizontalAlignment="Left" Grid.Row="3" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtDiaChi" Grid.Column="1" HorizontalContentAlignment="Left" Grid.Row="3" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" />
        
        <Label Content="So ngay nam vien" HorizontalAlignment="Left" Grid.Row="4" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtSoNgay" Grid.Column="1" HorizontalContentAlignment="Left" Grid.Row="4" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" />
        
        <Label Content="Khoa kham" HorizontalAlignment="Left" Grid.Row="5" VerticalContentAlignment="Center"/>
        <ComboBox x:Name="cboKhoaKham" Grid.Column="1" HorizontalContentAlignment="Left" Grid.Row="5"  VerticalAlignment="Center" Width="120" />

        <DataGrid GridLinesVisibility="Horizontal" Margin="10" x:Name="dgvHienthi" Grid.Row="6" Grid.ColumnSpan="2" AutoGenerateColumns="False" ColumnWidth="*">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Mabn}" Header="Ma Benh Nhan" />
                <DataGridTextColumn Binding="{Binding Hoten}" Header="Ho Ten" />
                <DataGridTextColumn Binding="{Binding MaKhoa}" Header="Ma Khoa" />
                <DataGridTextColumn Binding="{Binding DiaChi}" Header="Dia chi " />
                <DataGridTextColumn Binding="{Binding songayNV}" Header="So Ngay nam Vien" />
                <DataGridTextColumn Binding="{Binding VienPhi, StringFormat=N0}" Binding="{Binding Mabn}" CellStyle="{StaticResource thanhtienStyle}" Header="Vien Phi" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Template="{StaticResource btnTemp}" x:Name="btnThem" Margin="10" Width="70" Height="30 " Content="Them "/>
            <Button Template="{StaticResource btnTemp}" x:Name="BtnSua" Margin="10" Width="70" Height="30 " Content="Sua  "/>
            <Button Template="{StaticResource btnTemp}" x:Name="btnXoa" Margin="10" Width="70" Height="30 " Content="Xoa "/>
            <Button Template="{StaticResource btnTemp}" x:Name="btnThongKe" Margin="10" Width="70" Height="30 " Content="Thong ke "/>
        </StackPanel>





    </Grid>
</Window>
